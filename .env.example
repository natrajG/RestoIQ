POSTGRES_DB=restaurant_platform
POSTGRES_ADMIN_USER=platform_admin
POSTGRES_ADMIN_PASSWORD=replace-with-a-long-random-admin-password
POSTGRES_APP_USER=restaurant_app
POSTGRES_APP_PASSWORD=replace-with-a-long-random-app-password
DATABASE_URL=postgresql+psycopg://restaurant_app:replace-with-a-long-random-app-password@db:5432/restaurant_platform
MIGRATION_DATABASE_URL=postgresql+psycopg://platform_admin:replace-with-a-long-random-admin-password@db:5432/restaurant_platform
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-at-least-32-random-characters
CAMERA_ENCRYPTION_KEY=replace-with-a-distinct-random-camera-secret
COOKIE_SECURE=false
ENVIRONMENT=development
SEED_DEMO=true
DEMO_ADMIN_EMAIL=admin@demo.local
DEMO_ADMIN_PASSWORD=change-me-before-sharing
PLATFORM_ADMIN_EMAIL=platform@restoiq.local
PLATFORM_ADMIN_PASSWORD=replace-with-a-strong-password
VISION_API_KEY=replace-with-a-random-vision-service-key
UPLOAD_DIR=/data/uploads
VIDEO_RETENTION_DAYS=30
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
VITE_API_BASE=

# Razorpay (subscription payments). Use rzp_test_ keys until your account is KYC-activated.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set the same value in Razorpay Dashboard > Webhooks (URL: https://YOUR-DOMAIN/api/v1/billing/webhook, events: payment.captured)
RAZORPAY_WEBHOOK_SECRET=

# Your business details printed on subscription tax invoices. Leave blank until registered: invoices are then marked DRAFT.
# Confirm the SAC code and 18% rate with your accountant.
SELLER_LEGAL_NAME=
SELLER_GSTIN=
SELLER_ADDRESS=
SELLER_STATE_CODE=
SELLER_SAC=998314

# Email (password reset, welcome, receipts, renewal reminders). Resend API key + a sender on your verified domain,
# or SMTP_HOST/SMTP_PORT/SMTP_USERNAME/SMTP_PASSWORD instead of RESEND_API_KEY.
RESEND_API_KEY=
MAIL_FROM=RestoIQ <no-reply@yourdomain.com>
# Used as the sender if MAIL_FROM is empty
FEEDBACK_NOTIFY_EMAIL=
# Public address of the app, used in email links
APP_PUBLIC_URL=http://localhost:8180
